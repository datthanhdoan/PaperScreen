<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn with views (not a bitmap) so it follows the theme and stays localisable:
     the App info top bar with the overflow button ringed and its menu item open. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_illustration"
    android:contentDescription="@string/restricted_illustration"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ios_secondary_label" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/restricted_mock_title"
            android:textColor="@color/ios_label"
            android:textSize="15sp" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/illustration_highlight_ring"
            android:padding="6dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ios_label" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_illustration_menu"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/restricted_mock_item"
            android:textColor="@color/ios_label"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/restricted_mock_item_en"
            android:textColor="@color/ios_secondary_label"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
